# ============================================================
# sci_assistant 后端环境变量示例
# 复制为 .env 并填入真实值;真实密钥只放本地 .env,不入库。
# 实际环境变量优先级高于本文件(测试/CI 可用环境变量覆盖)。
# ============================================================

# ── 应用 ──
APP_NAME=sci_assistant
PORT=8001
DEBUG=false

# ── LLM:主/副由 LLM_PRIMARY 决定(bailian|siliconflow),主失败自动降级到副 ──
LLM_PRIMARY=siliconflow
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=sk-your-bailian-key
BAILIAN_MODEL=qwen-plus
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
LLM_TIMEOUT=120

# ── JWT 鉴权(生产必须改强随机串)──
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── PostgreSQL(关系元数据 + 切片正文)──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sci_assistant

# ── Redis(会话记忆 + 限流 + Celery broker)──
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=86400

# ── MinIO(原始文档 blob)──
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sci-assistant
MINIO_SECURE=false

# ── Milvus(向量库)──
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=sci_assistant_chunks

# ── 检索参数 ──
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE=20
RRF_K=60
USE_HYDE=false

# ── 文档解析(router|api_only|local_only;MinerU 为可选 PDF 深度解析)──
PARSER_MODE=router
MINERU_API_URL=https://mineru.net/api/v4/extract/task
MINERU_API_TOKEN=

# ── 切片 ──
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Embedding / Reranker(本地 bge 系列,首次运行自动下载)──
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_ENDPOINT=https://hf-mirror.com

# ── MCP 对外工具服务 ──
# 传输方式:stdio(本地客户端)| http(streamable-http,监听 MCP_HOST:MCP_PORT)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8002
# API Key 与用户绑定,格式 "key1:email1,key2:email2";留空 = 拒绝所有外部调用
# stdio 客户端在启动环境里设 MCP_API_KEY(或 --api-key 参数);http 客户端每次调用带 X-API-Key 头
MCP_API_KEYS=
# 写操作工具(index_document)默认关闭;true 时仅建议在受控网络开启
MCP_ENABLE_WRITE_TOOLS=false
# 限流:每 Key 每分钟总调用数 / query(耗 LLM)单独上限
MCP_RATE_LIMIT=30
MCP_QUERY_RATE_LIMIT=10
# get_document_content 输出字符上限
MCP_MAX_CONTENT_CHARS=8000
